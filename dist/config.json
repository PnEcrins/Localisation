{
  "apiBaseUrl": "https://geonature.ecrins-parcnational.fr/api/geo",

  "map": {
    "center": [6.2, 44.9],
    "zoom": 10,
    "maxZoom": 19
  },

  "areaTypes": {
    "communes": { "idType": 25, "codeDepartementsPrefix": ["05", "38"] },
    "secteurs": { "idType": 30 },
    "excludedZonageTypeCodes": [
      "COM",
      "DEP",
      "REG",
      "SEC",
      "MAS",
      "ZBIOG",
      "M10",
      "M5",
      "M1",
      "UG",
      "PEC",
      "AA",
      "PAF",
      "SOPHIE",
      "TPN",
      "ALPAGES_ZP",
      "ALPAGES_UP",
      "ALPAGES_ZH"
    ]
  },

  "layers": [
    {
      "id": "ign-scan",
      "label": "Scan IGN",
      "type": "wmts",
      "baseLayer": true,
      "url": "https://data.geopf.fr/private/wmts",
      "layer": "GEOGRAPHICALGRIDSYSTEMS.MAPS",
      "style": "normal",
      "tileMatrixSet": "PM",
      "format": "image/jpeg",
      "attribution": "IGN-F/Geoportail",
      "enabled": true,
      "apiKey": "ign_scan_ws",
      "apiKeyName": "apikey"
    },
    {
      "id": "ign-plan",
      "label": "Plan IGN",
      "type": "wmts",
      "baseLayer": true,
      "url": "https://data.geopf.fr/wmts",
      "layer": "GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2",
      "style": "normal",
      "tileMatrixSet": "PM",
      "format": "image/png",
      "attribution": "IGN-F/Geoportail",
      "enabled": false
    },
    {
      "id": "ign-ortho",
      "label": "Photographies aériennes",
      "type": "wmts",
      "baseLayer": true,
      "url": "https://data.geopf.fr/wmts",
      "layer": "ORTHOIMAGERY.ORTHOPHOTOS",
      "style": "normal",
      "tileMatrixSet": "PM",
      "format": "image/jpeg",
      "attribution": "IGN-F/Geoportail",
      "enabled": false
    },
    {
      "id": "ign-scan-constat",
      "label": "Scan constant",
      "type": "wmts",
      "baseLayer": true,
      "url": "https://data.geopf.fr/private/wmts",
      "layer": "GEOGRAPHICALGRIDSYSTEMS.MAPS.SCAN25TOUR",
      "style": "normal",
      "tileMatrixSet": "PM",
      "format": "image/jpeg",
      "attribution": "IGN-F/Geoportail",
      "enabled": false,
      "apiKey": "ign_scan_ws",
      "apiKeyName": "apikey"
    },
    {
      "id": "ign-cadastre",
      "label": "Cadastre",
      "type": "wmts",
      "baseLayer": false,
      "url": "https://data.geopf.fr/wmts",
      "layer": "CADASTRALPARCELS.PARCELLAIRE_EXPRESS",
      "style": "normal",
      "tileMatrixSet": "PM",
      "format": "image/png",
      "attribution": "IGN-F/Geoportail (DGFiP)",
      "enabled": false
    },
    {
      "id": "AOA",
      "label": "Aire d'adhésion",
      "type": "geojson",
      "enabled": true,
      "url": "https://geonature.ecrins-parcnational.fr/api/geo/areas?type_code=PEC&format=geojson&limit=2000",
      "style": {
        "color": "#000000",
        "weight": 2,
        "fillOpacity": 0
      }
    },
    {
      "id": "coeur_pne",
      "label": "Cœur du PNE",
      "type": "geojson",
      "enabled": true,
      "url": "https://geonature.ecrins-parcnational.fr/api/geo/areas?type_code=ZC&format=geojson&limit=2000",
      "style": {
        "color": "#a12ebe",
        "weight": 4,
        "fillOpacity": 0
      }
    }
  ]
}
